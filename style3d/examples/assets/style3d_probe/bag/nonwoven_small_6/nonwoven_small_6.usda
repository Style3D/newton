                asset inputs:normalmap_texture = @nonwoven_small_6_Normal_1002.png@ (
                    colorSpace = "raw"
                )
                float inputs:opacity_constant = 1
                asset inputs:opacity_texture = @nonwoven_small_6_Transparent_1002.png@ (
                    colorSpace = "raw"
                )
                float inputs:reflection_roughness_constant = 0.8
                asset inputs:reflectionroughness_texture = @nonwoven_small_6_Roughness_1002.png@ (
                    colorSpace = "raw"
                )
                token outputs:out
            }
        }
    }
}

